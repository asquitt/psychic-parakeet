# Database Configuration
POSTGRES_USER=mlpipeline
POSTGRES_PASSWORD=changeme123
POSTGRES_DB=mlpipeline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MLflow Configuration
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://mlpipeline:changeme123@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# Prefect Configuration
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://mlpipeline:changeme123@postgres:5432/prefect

# Model Serving Configuration
MODEL_SERVICE_HOST=0.0.0.0
MODEL_SERVICE_PORT=8000
MODEL_REGISTRY_URI=http://mlflow:5000

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Deployment Configuration
DEPLOYMENT_STRATEGY=canary  # canary, blue_green, rolling
CANARY_TRAFFIC_PERCENTAGE=10
ROLLBACK_THRESHOLD=0.05  # 5% performance degradation triggers rollback

# Data Drift Configuration
DRIFT_DETECTION_ENABLED=true
DRIFT_CHECK_INTERVAL_HOURS=24
DRIFT_THRESHOLD=0.1

# Performance Monitoring
LATENCY_THRESHOLD_MS=100
THROUGHPUT_MIN_RPS=10
PERFORMANCE_CHECK_INTERVAL_MINUTES=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
